clc
close all
clear
t(1)=0;
f_2(1)=0;
a = 3;
b = 1;
i=1;
%% 2
while abs(f_2-a./(a+b))>.01
    f_2(i+1)=a.*(1-exp(-(a+b).*t(i)))./(a+b);
    
    i=i+1;
    t(i) = t(i-1) + 0.01;
end
figure
plot(t, f_2, 'o')
xlabel('Time')
ylabel('f_2')
grid on

%% 3

Q=[-2,2,0,0;1,-3,2,0;0,2,-4,2;0,0,3,-3];

lambda=eig(Q)
sum_lambda=sum(lambda)
figure
plot(real(lambda), imag(lambda), 'x')
xlabel('Real part')
ylabel('Imaginary part')
grid on
t=0:.1:5;
x_0=[1,0,0,0];
pi_stationary=[3;6;6;4]./19;
TV_0
x_t=zeros(length(t), length(x_0));
for i=1:length(t)
    x_t(i, :) =x_0*expm(Q*t(i));
end






figure
hold on
plot(t, x_t)
yline(pi_stationary,'--r','LineWidth',2)
xlabel('Time')
ylabel('State probabilities')
legend('0 Positions','1','State 2','State 3')
grid on
hold off